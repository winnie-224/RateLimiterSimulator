<Window x:Class="RateLimiterSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API Gateway – Rate Limiter Simulator"
        Height="700"
        Width="900">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Client -->
            <RowDefinition Height="Auto"/>
            <!-- Gateway -->
            <RowDefinition Height="Auto"/>
            <!-- Token Bucket -->
            <RowDefinition Height="*"/>
            <!-- Metrics -->
        </Grid.RowDefinitions>

        <!-- ================= CLIENT / TRAFFIC GENERATOR ================= -->
        <GroupBox Header="Client / Traffic Generator"
                  Margin="0,0,0,16">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Client ID:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox x:Name="ClientIdBox"
                         Grid.Column="1"
                         Height="28"
                         Margin="0,0,16,0"/>

                <TextBlock Text="Algorithm:"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <ComboBox x:Name="AlgorithmSelector"
                          Grid.Column="3"
                          Height="28"
                          SelectionChanged="AlgorithmSelector_SelectionChanged"
                          >
                    <ComboBoxItem Content="Token Bucket" IsSelected="True"/>
                    <ComboBoxItem Content="Sliding Window"/>
                </ComboBox>

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            Margin="16,0,0,0">
                    <Button Content="Send Request"
                            Width="120"
                            Height="30"
                            Margin="0,0,8,0"
                            Click="SendRequest_Click"/>
                    <Button Content="Send Burst (10)"
                            Width="130"
                            Height="30"
                            Click="SendBurst_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ================= API GATEWAY DECISION ================= -->
        <GroupBox Grid.Row="1"
                  Header="API Gateway Decision"
                  Margin="0,0,0,16">
            <StackPanel Margin="12">
                <TextBlock Text="Last Request Status:"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>

                <Border x:Name="DecisionIndicator"
                        Height="40"
                        CornerRadius="4"
                        Background="LightGray"
                        Padding="10">
                    <TextBlock x:Name="DecisionText"
                               Text="No request yet"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                </Border>
            </StackPanel>
        </GroupBox>

        <!-- ================= TOKEN BUCKET VISUALIZATION ================= -->
        <GroupBox Grid.Row="2"
                  Header="Token Bucket"
                  Margin="0,0,0,16">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Tokens Remaining:"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>

                <ProgressBar x:Name="TokenProgressBar"
                             Grid.Row="1"
                             Height="24"
                             Minimum="0"
                             Maximum="10"
                             Value="0"/>

                <TextBlock x:Name="TokenCountText"
                           Grid.Row="1"
                           HorizontalAlignment="Right"
                           Margin="0,6,0,0"
                           Text="0 / 10"/>
            </Grid>
        </GroupBox>

        <!-- ================= METRICS DASHBOARD ================= -->
        <GroupBox Grid.Row="3"
                  Header="Metrics Dashboard">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Request Metrics -->
                <StackPanel>
                    <TextBlock Text="Request Metrics"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="TotalRequestsText"
                               Text="Total Requests: 0"/>
                    <TextBlock x:Name="AllowedRequestsText"
                               Text="Allowed: 0"/>
                    <TextBlock x:Name="BlockedRequestsText"
                               Text="Blocked: 0"/>
                </StackPanel>

                <!-- Rate Information -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Rate Limiter Settings"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="BucketCapacityText"
                               Text="Bucket Capacity: 10"/>
                    <TextBlock x:Name="RefillRateText"
                               Text="Refill Rate: 1 token/sec"/>
                </StackPanel>
            </Grid>
        </GroupBox>

    </Grid>
</Window>
